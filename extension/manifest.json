{
  "manifest_version": 3,
  "name": "Pickup Watcher for Apple Store",
  "short_name": "Pickup Watcher",
  "version": "0.1.0",
  "description": "Watches Apple Store in-store pickup for the products and stores you choose, and notifies you when one is in stock.",
  "minimum_chrome_version": "130",
  "permissions": ["alarms", "storage", "unlimitedStorage", "scripting", "notifications"],
  "host_permissions": ["https://www.apple.com/*", "https://api.day.app/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Pickup Watcher status", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
